@startuml load_case_flow
title Load-case flow: direct FE analysis, combinations and envelopes

|builder|
start
:build_bridge_model(bridge);

|loads|
:apply_dead_loads (dead_loads);
:load_builders
pressure / line / point / braking / seismic /
wind / temperature_gradient / fatigue_moving_load;
note right: each returns a LoadCase
:LoadCase (load_cases);

|irc6|
:irc6_uls_recipes / irc6_sls_recipes /
irc6_fatigue_recipe / irc6_construction_recipe
(combinations: factor per load name);

|loads|
:combine(cases, factors) → one LoadCase;

|postprocess|
:analyze_load_case (girder_response)
apply_load_case → solve → girder_forces;
:girder_deflections / reactions;
:envelope / envelope_with_deflections;
fork
  :plots;
fork again
  :build_result_dataset (result_dataset);
end fork
stop
@enduml
