@startuml layers
title setu layers (arrow = imports from)
skinparam packageStyle rectangle
top to bottom direction

package "models" as models #E3F2FD
package "irc6" as irc6 #FFF3E0
package "builder" as builder #E8F5E9
package "loads" as loads #FCE4EC
package "solver" as solver #EDE7F6
package "analysis" as analysis #E0F7FA
package "postprocess" as postprocess #F1F8E9
package "helpers / errors" as common #EEEEEE

builder --> models
builder ..> solver : opensees
loads --> builder
loads --> irc6
loads ..> solver : opensees
analysis --> builder
analysis --> irc6
analysis --> solver
postprocess --> loads

models --> common
irc6 --> common
builder --> common
loads --> common
solver --> common
analysis --> common
@enduml
